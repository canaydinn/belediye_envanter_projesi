{
  "functions": {
    "api/index.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/admin/(.*)",
      "destination": "/api/admin/$1"
    },
    {
      "source": "/",
      "destination": "/api/"
    },
    {
      "source": "/((?!api).+)",
      "destination": "/api/$1"
    }
  ]
}