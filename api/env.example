# Supabase Database Connection
# ÖNEMLİ: Connection string'i Supabase Dashboard'dan alın!
# Settings → Database → Connection string → URI formatını kopyalayın

# Yöntem 1: Connection String (ÖNERİLEN - Supabase Dashboard'dan alın)
# SUPABASE_DB_CONNECTION_STRING=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?sslmode=require
# VEYA connection pooling için:
# SUPABASE_DB_CONNECTION_STRING=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

# Yöntem 2: Ayrı ayrı parametreler (connection string çalışmazsa)
# Not: Host genellikle db.[PROJECT_REF].supabase.co formatındadır (https:// protokolü OLMAMALI!)
SUPABASE_DB_HOST=db.qdmyveocfdjvpqziswxk.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=4Fx7QbQ3h74lceLN
SUPABASE_DB_NAME=postgres
SUPABASE_DB_SSL=true

# Supabase API
SUPABASE_URL=https://qdmyveocfdjvpqziswxk.supabase.co
